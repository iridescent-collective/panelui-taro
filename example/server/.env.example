# Copy to server/.env.local. All provider values stay on the server.
AI_BASE_URL=https://your-provider.example/v1
AI_API_KEY=
AI_MODEL=
# Optional: this provider must support the corresponding audio endpoints.
AI_TRANSCRIPTION_MODEL=
AI_SPEECH_MODEL=
AI_SPEECH_VOICE=alloy
# Set to your development machine's LAN IP for phone testing.
AI_DEMO_HOST=127.0.0.1
AI_DEMO_PORT=3101
# Comma-separated browser origins, if needed; empty denies cross-origin browsers.
AI_ALLOWED_ORIGINS=
